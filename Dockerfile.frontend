# Python base image
FROM python:3.13-slim

# Working directory
WORKDIR /app

# Install frontend dependencies
COPY requirements.frontend.txt .

RUN pip install --no-cache-dir -r requirements.frontend.txt

# Copy UI folder
COPY UI/ ./UI/

# Copy frontend application
COPY frontend/ ./frontend/

# Python import path
ENV PYTHONPATH=/app

# Streamlit port
EXPOSE 10000

# Start Streamlit
CMD ["sh", "-c", "exec python -m streamlit run frontend/app.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --server.headless true"]